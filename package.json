{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "Plywright Framework",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "test:weblighthouse": "node ./src/test/qualitycheck/WebLighthouse.mjs",
    "test:mobilelighthouse": "node ./src/test/qualitycheck/MobileLighthouse.mjs",
    "//comment": "============================= API Testing  ===================================",
    "test:qa:api": "cross-env NODE_ENV='qa' npx playwright test --trace on ./src/test/scriptLibrary/api || true",
    "//comment1": "============================= UI Testing  ===================================",
    "test:qa:ui": "cross-env NODE_ENV='qa' npx playwright test  --trace on ./src/test/scriptLibrary/ui",
    "//comment2": "============================= Cucumber ===================================",
    "test:cucumber:qa": "cross-env NODE_ENV='qa' FORCE_COLOR=0 npx bddgen && npx playwright test",
    "//comment3": "============================= Allure Report Generation =================================",
    "report:allure": "allure generate ./reports/allure-results -o ./reports/allure-report --clean && allure open ./reports/allure-report",
    "report:playwright": "npx playwright show-report ./reports/html-report",
    "merge_report": "node reports_merge.js",
    "noderun": ""
  },
  "author": "DhowlathBasha",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@cucumber/cucumber": "^10.7.0",
    "@playwright/test": "^1.44.1",
    "@types/convert-excel-to-json": "1.7.4",
    "@types/easy-soap-request": "^4.1.4",
    "@types/ibm_db": "^2.0.16",
    "@types/jsonpath": "^0.2.4",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.12.12",
    "@types/oracledb": "^6.5.0",
    "@types/randomstring": "^1.3.0",
    "@types/string-format": "^2.0.3",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^2.15.1",
    "convert-excel-to-json": "1.7.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "easy-soap-request": "^5.6.1",
    "eslint": "^9.3.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-plugin-playwright": "1.6.2",
    "exceljs": "^4.4.0",
    "fetch-to-curl": "0.6.0",
    "husky": "^9.0.11",
    "jasmine-xml2html-converter": "0.0.2",
    "jsonpath": "1.1.1",
    "lighthouse": "^12.0.0",
    "moment": "^2.30.1",
    "monocart-reporter": "2.4.7",
    "mssql": "^10.0.2",
    "oracledb": "^6.5.1",
    "pdf-parse": "1.1.1",
    "pdfjs-dist-es5": "^2.13.216",
    "playwright": "^1.44.1",
    "playwright-bdd": "^6.4.0",
    "playwright-merge-html-reports": "^0.2.8",
    "randomstring": "1.3.0",
    "string-format": "2.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "winston": "^3.13.0",
    "xml-formatter": "3.6.2",
    "xmldom": "0.6.0",
    "xpath": "0.0.34"
  }
}
