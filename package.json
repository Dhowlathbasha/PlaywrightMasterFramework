{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "Playwright Framework",
  "main": "index.js",
  "scripts": {
    "lint": "eslint \"{main,tests}/**/*.ts\" \"playwright.config.ts\"",
    "lint:fix": "eslint \"{main,tests}/**/*.ts\" \"playwright.config.ts\" --fix",
    "prettier": "prettier \"{main,tests}/**/*.ts\" \"playwright.config.ts\" --check",
    "prettier:fix": "prettier \"{main,tests}/**/*.ts\" \"playwright.config.ts\" --write",
    "prepare": "husky",
    "postinstall": "husky init",
    "launch:Allocator": "npx tsx Allocator.ts",
    "clean": "rm -rf out",
    "//comment": "============================= API Testing  ===================================",
    "test:qa:api": "cross-env NODE_ENV='qa' npx playwright test --trace on ./tests/scriptLibrary/api || true",
    "//comment1": "============================= UI Testing  ===================================",
    "test:qa:ui": "cross-env NODE_ENV='qa' npx playwright test ./tests/scriptLibrary/ui",
    "//comment2": "============================= Cucumber ===================================",
    "test:cucumber:qa": "cross-env NODE_ENV='qa' FORCE_COLOR=0 npx bddgen && npx playwright test",
    "//comment3": "============================= Allure Report Generation =================================",
    "report:allure": "allure generate ./test-results/allure-results -o ./test-results/allure-report --clean && allure open ./test-results/allure-report",
    "report:playwright": "npx playwright show-report ./test-results/html-report",
    "test:qa:suite": "cross-env NODE_ENV='qa' npx playwright test ./tests/scriptLibrary/Suites",
    "ts-coverage": "typescript-coverage-report"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "author": "DhowlathBasha",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cucumber/cucumber": "^11.0.1",
    "@playwright/test": "^1.48.1",
    "@types/ibm_db": "^2.0.16",
    "@types/jsonpath": "^0.2.4",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.7.9",
    "@types/oracledb": "^6.5.2",
    "@types/randomstring": "^1.3.0",
    "@types/string-format": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@xmldom/xmldom": "^0.9.4",
    "allure-commandline": "^2.31.0",
    "allure-playwright": "^3.0.5",
    "axios": "^1.7.7",
    "cross-env": "^7.0.3",
    "csvtojson": "^2.0.10",
    "dom-parser": "^1.1.5",
    "dotenv": "^16.4.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-playwright": "^2.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unicorn": "^56.0.0",
    "exceljs": "^4.4.0",
    "fetch-to-curl": "0.6.0",
    "har-to-openapi": "^2.1.0",
    "husky": "^9.1.6",
    "jasmine-xml2html-converter": "0.0.2",
    "jsonpath": "1.1.1",
    "lint-staged": "^15.2.10",
    "moment": "^2.30.1",
    "monocart-reporter": "2.9.6",
    "mssql": "^11.0.1",
    "oracledb": "^6.6.0",
    "pdf-parse": "1.1.1",
    "pdfjs-dist-es5": "^2.13.216",
    "playwright": "^1.48.1",
    "playwright-bdd": "^7.5.0",
    "prettier": "3.3.3",
    "randomstring": "1.3.0",
    "string-format": "2.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "winston": "^3.15.0",
    "xml-formatter": "^3.6.3",
    "xpath": "0.0.34"
  }
}
