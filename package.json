{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "Plywright Framework",
  "main": "index.js",
  "scripts": {
    "lint": "eslint \"{main,tests}/**/*.ts\" \"playwright.config.ts\"",
    "lint:fix": "eslint \"{main,tests}/**/*.ts\" \"playwright.config.ts\" --fix",
    "prettier": "prettier \"{main,tests}/**/*.ts\" \"playwright.config.ts\" --check",
    "prettier:fix": "prettier \"{main,tests}/**/*.ts\" \"playwright.config.ts\" --write",
    "prepare": "husky",
    "postinstall": "husky install",
    "launch:Allocator": "npx tsx Allocator.ts",
    "clean": "rm -rf out",
    "//comment": "============================= API Testing  ===================================",
    "test:qa:api": "cross-env NODE_ENV='qa' npx playwright test --trace on ./tests/scriptLibrary/api || true",
    "//comment1": "============================= UI Testing  ===================================",
    "test:qa:ui": "cross-env NODE_ENV='qa' npx playwright test ./tests/scriptLibrary/ui",
    "//comment2": "============================= Cucumber ===================================",
    "test:cucumber:qa": "cross-env NODE_ENV='qa' FORCE_COLOR=0 npx bddgen && npx playwright test",
    "//comment3": "============================= Allure Report Generation =================================",
    "report:allure": "allure generate ./test-results/allure-results -o ./test-results/allure-report --clean && allure open ./test-results/allure-report",
    "report:playwright": "npx playwright show-report ./test-results/html-report"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "author": "DhowlathBasha",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.44.1",
    "@types/easy-soap-request": "^4.1.4",
    "@types/ibm_db": "^2.0.16",
    "@types/jsonpath": "^0.2.4",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.2",
    "@types/oracledb": "^6.5.1",
    "@types/randomstring": "^1.3.0",
    "@types/string-format": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "@xmldom/xmldom": "^0.8.10",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^2.15.1",
    "cross-env": "^7.0.3",
    "dom-parser": "^1.1.5",
    "dotenv": "^16.4.5",
    "easy-soap-request": "^5.6.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unicorn": "^53.0.0",
    "exceljs": "^4.4.0",
    "fetch-to-curl": "0.6.0",
    "husky": "^9.0.11",
    "jasmine-xml2html-converter": "0.0.2",
    "jsonpath": "1.1.1",
    "lint-staged": "^15.2.5",
    "moment": "^2.30.1",
    "monocart-reporter": "2.4.8",
    "mssql": "^10.0.2",
    "oracledb": "^6.5.1",
    "pdf-parse": "1.1.1",
    "pdfjs-dist-es5": "^2.13.216",
    "playwright": "^1.44.1",
    "playwright-bdd": "^6.5.0",
    "playwright-merge-html-reports": "^0.2.8",
    "prettier": "3.3.1",
    "randomstring": "1.3.0",
    "string-format": "2.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.2",
    "typescript": "^5.4.5",
    "winston": "^3.13.0",
    "xml-formatter": "^3.6.2",
    "xpath": "0.0.34"
  }
}
